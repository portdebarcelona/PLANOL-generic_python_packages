	"settings": {
		"python.terminal.activateEnvironment": false,
		"python.defaultInterpreterPath": "C:\\Users\\ARREDOER\\AppData\\Local\\miniconda3\\envs\\PLANOL-apb_python_packages-DEV\\python.exe",
		"ruff.lint.select": ["E9", "E722", "F"],
		"ruff.lint.ignore": ["F401"]
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.debugpy",
			"charliermarsh.ruff",
			"ms-azuretools.vscode-docker"
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "apb: python current file",
				"type": "shell",
				"command": "\"${workspaceFolder:apb-python-packages}\\.vscode\\compose_python.cmd\" python_planol_dev \"${relativeFile}\"",
				"options": {
					"cwd": "${workspaceFolder:apb-python-packages}"
				},
				"problemMatcher": [],
				"group": "build"
			},
			{
				"label": "apb: unittest current file",
				"type": "shell",
				"command": "\"${workspaceFolder:apb-python-packages}\\.vscode\\compose_python.cmd\" python_planol_dev -m unittest \"${relativeFile}\"",
				"options": {
					"cwd": "${workspaceFolder:apb-python-packages}"
				},
				"problemMatcher": [],
				"group": "test"
			},
			{
				"label": "apb: debugpy current file",
				"type": "shell",
				"command": "\"${workspaceFolder:apb-python-packages}\\.vscode\\compose_debugpy.cmd\" python_planol_dev /opt/project_apb 5679 file \"${relativeFile}\"",
				"options": {
					"cwd": "${workspaceFolder:apb-python-packages}"
				},
				"isBackground": true,
				"problemMatcher": {
					"owner": "debugpy",
					"pattern": { "regexp": "^$" },
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "(Listening for debug|waiting for.*client|0\\.0\\.0\\.0:5679|debugpy.*5679)"
					}
				}
			},
			{
				"label": "apb: debugpy unittest current file",
				"type": "shell",
				"command": "\"${workspaceFolder:apb-python-packages}\\.vscode\\compose_debugpy.cmd\" python_planol_dev /opt/project_apb 5679 unittest \"${relativeFile}\"",
				"options": {
					"cwd": "${workspaceFolder:apb-python-packages}"
				},
				"isBackground": true,
				"problemMatcher": {
					"owner": "debugpy",
					"pattern": { "regexp": "^$" },
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "(Listening for debug|waiting for.*client|0\\.0\\.0\\.0:5679|debugpy.*5679)"
					}
				}
			},
			{
				"label": "generic: debugpy current file",
				"type": "shell",
				"command": "\"${workspaceFolder:generic_python_packages}\\.vscode\\compose_debugpy.cmd\" python_packages /project 5678 file \"${relativeFile}\"",
