				"label": "generic: debugpy unittest current file",
				"type": "shell",
				"command": "\"${workspaceFolder:generic_python_packages}\\.vscode\\compose_debugpy.cmd\" python_packages /project 5678 unittest \"${relativeFile}\"",
				"options": { "cwd": "${workspaceFolder:generic_python_packages}" },
