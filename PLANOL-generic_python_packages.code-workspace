			{
				"name": "QGIS DEV: Current File",
				"type": "python",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal",
				"cwd": "${workspaceFolder:apb-qgis}",
				"python": "${workspaceFolder:apb-qgis}/config/python/python_qgis_DEV.bat",
