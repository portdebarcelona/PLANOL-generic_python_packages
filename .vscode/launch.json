{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker python_packages: Current File",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "preLaunchTask": "compose: debugpy current file",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/project"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "Docker python_packages: Unittest Current File",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "preLaunchTask": "compose: debugpy unittest current file",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/project"
        }
      ],
      "justMyCode": true
    }
  ]
}
